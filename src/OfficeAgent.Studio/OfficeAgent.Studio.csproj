  <ItemGroup>
    <PackageReference Include="OfficeAgent.Core" Version="0.5.0" />
    <PackageReference Include="OfficeAgent.Word" Version="0.5.0" />
    <PackageReference Include="OfficeAgent.PowerPoint" Version="0.5.0" />
  </ItemGroup>
  -->

</Project>
