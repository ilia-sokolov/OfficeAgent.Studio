<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OfficeAgent.Studio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <!--
    OfficeAgent comes from a sibling checkout when there is one, and from NuGet otherwise.

    The path is anchored to this file rather than to the working directory, because a
    relative path that depends on where you happened to run dotnet from breaks the moment
    the repository is cloned one level deeper - and it breaks silently, since a
    ProjectReference inside a failed Exists() condition simply disappears and leaves you
    reading fifty "type or namespace does not exist" errors instead of one useful one.
  -->
  <PropertyGroup>
    <!--
      Candidate locations, in order. The first is the ordinary case: OfficeAgent.NET cloned
      beside this repository. The others cover the layout where either repository is nested
      one level inside a folder of its own name, which is what a GitHub Desktop clone into
      an existing folder produces.
    -->
    <_OfficeAgentSibling>$(MSBuildThisFileDirectory)..\..\..\OfficeAgent.NET\src</_OfficeAgentSibling>
    <_OfficeAgentNestedBoth>$(MSBuildThisFileDirectory)..\..\..\..\OfficeAgent.NET\OfficeAgent.NET\src</_OfficeAgentNestedBoth>
    <_OfficeAgentNestedSelf>$(MSBuildThisFileDirectory)..\..\..\..\OfficeAgent.NET\src</_OfficeAgentNestedSelf>

    <OfficeAgentSource Condition="Exists('$(_OfficeAgentSibling)\OfficeAgent.Core\OfficeAgent.Core.csproj')">$(_OfficeAgentSibling)</OfficeAgentSource>
    <OfficeAgentSource Condition="'$(OfficeAgentSource)' == '' And Exists('$(_OfficeAgentNestedBoth)\OfficeAgent.Core\OfficeAgent.Core.csproj')">$(_OfficeAgentNestedBoth)</OfficeAgentSource>
    <OfficeAgentSource Condition="'$(OfficeAgentSource)' == '' And Exists('$(_OfficeAgentNestedSelf)\OfficeAgent.Core\OfficeAgent.Core.csproj')">$(_OfficeAgentNestedSelf)</OfficeAgentSource>

    <UseOfficeAgentSource Condition="'$(OfficeAgentSource)' != ''">true</UseOfficeAgentSource>
    <OfficeAgentVersion>0.6.0</OfficeAgentVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseOfficeAgentSource)' == 'true'">
    <ProjectReference Include="$(OfficeAgentSource)\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="$(OfficeAgentSource)\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="$(OfficeAgentSource)\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOfficeAgentSource)' != 'true'">
    <PackageReference Include="OfficeAgent.Core" Version="$(OfficeAgentVersion)" />
    <PackageReference Include="OfficeAgent.Word" Version="$(OfficeAgentVersion)" />
    <PackageReference Include="OfficeAgent.PowerPoint" Version="$(OfficeAgentVersion)" />
  </ItemGroup>

  <Target Name="ReportOfficeAgentSource" BeforeTargets="Build">
    <Message Importance="high" Condition="'$(UseOfficeAgentSource)' == 'true'"
             Text="OfficeAgent: building against the sibling checkout at $(OfficeAgentSource)" />
    <Message Importance="high" Condition="'$(UseOfficeAgentSource)' != 'true'"
             Text="OfficeAgent: building against NuGet packages $(OfficeAgentVersion)" />
  </Target>

</Project>
