<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OfficeAgent.Studio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <!--
    Built against the OfficeAgent working tree, because the slide fill and background this
    demo relies on land in 0.5.0 and are not on NuGet yet. Once 0.5.0 ships, delete this
    block and uncomment the package references below - nothing else in the project changes.
  -->
  <ItemGroup Condition="Exists('..\..\..\OfficeAgent.NET\OfficeAgent.NET\src\OfficeAgent.Core\OfficeAgent.Core.csproj')">
    <ProjectReference Include="..\..\..\OfficeAgent.NET\OfficeAgent.NET\src\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\..\..\OfficeAgent.NET\OfficeAgent.NET\src\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="..\..\..\OfficeAgent.NET\OfficeAgent.NET\src\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
  </ItemGroup>

